{
  "name": "qingxpuli-github-pages",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run verify:media",
    "build": "next build",
    "verify:media": "node tools/verify-media-credits.mjs",
    "generate:meta": "node tools/generate-static-meta.mjs",
    "postbuild": "node tools/generate-static-meta.mjs && node tools/prepare-pages.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "optimize:images": "node tools/optimize-images.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.468.0",
    "next": "^16.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.2.1",
    "sharp": "^0.35.4",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
